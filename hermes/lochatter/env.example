# Copy into the Hermes plugin environment. Do not commit the filled file.
# LOCHATTER_TOKEN comes from `chatterctl bot token` on the chat server.
LOCHATTER_TOKEN=
LOCHATTER_URL=https://chat.example.com
LOCHATTER_HOME_CHANNEL=chat
# Voice calls only. Base URL includes /v1. Model ids must be ones that server actually lists.
LOCHATTER_HUB_BASE=https://hub.example.com/v1
LOCHATTER_STT_KEY=
LOCHATTER_STT_MODEL=
LOCHATTER_TTS_MODEL=
LOCHATTER_TTS_VOICE=
