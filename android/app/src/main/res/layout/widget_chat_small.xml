<?xml version="1.0" encoding="utf-8"?>
<!-- Compact (2x1) widget: name + presence on top, one row of three icon buttons below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_dot_offline"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="lochatter" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="离线" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_btn_voice"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_widget_call"
            android:tint="@color/widget_accent"
            android:contentDescription="@string/widget_voice" />

        <ImageView
            android:id="@+id/widget_btn_video"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_videocam"
            android:tint="@color/widget_accent"
            android:contentDescription="@string/widget_video" />

        <LinearLayout
            android:id="@+id/widget_btn_bot"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_button_bg">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bot"
                android:tint="@color/widget_accent"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_bot_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/widget_text"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_bot" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
