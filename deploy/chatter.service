[Unit]
Description=chatter server (private 1:1 chat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatter
Group=chatter
WorkingDirectory=/opt/chatter/rel
ExecStart=/opt/chatter/rel/chatter-server
Environment=ASPNETCORE_URLS=http://127.0.0.1:5088
Environment=DOTNET_ENVIRONMENT=Production
Environment=CHATTER_DATA=/var/lib/chatter
EnvironmentFile=-/etc/chatter/turn.env
EnvironmentFile=-/etc/chatter/geo.env
EnvironmentFile=-/etc/chatter/stt.env
Restart=always
RestartSec=2
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chatter

[Install]
WantedBy=multi-user.target
