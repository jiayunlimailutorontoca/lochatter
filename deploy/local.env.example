# Copy to deploy/local.env (gitignored). Scripts next to this file read it.
# On the server the same keys live in /etc/chatter/deploy.env, which is also not in git.
CHATTER_DOMAIN=chat.example.com
# Optional override for the URL baked into an Android build.
# Empty means: android/server.properties, otherwise https://$CHATTER_DOMAIN.
# CHATTER_SERVER_URL=https://chat.example.com
# Certificate directory under /etc/nginx/ssl/. Often the same as the domain.
# Set it separately when the cert folder is named after the parent domain.
CHATTER_SSL_DIR=chat.example.com
CHATTER_HOST=YOUR_SERVER_IP
# Leave empty to use whatever port ssh already uses. Set it only when ssh needs -p.
CHATTER_SSH_PORT=
# Optional. Where deploy.sh clones from when /opt/chatter/src does not exist yet.
# CHATTER_REPO=https://github.com/jiayunlimailutorontoca/lochatter.git
# Optional shell command. backup.sh saves its stdout as extra.dump.
# CHATTER_EXTRA_BACKUP=
